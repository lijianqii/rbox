# Rust / cargo 构建产物
/target

# rbox 构建产物（由 make rootfs/initramfs 生成）
/initramfs.cpio.gz
# 测试用 initramfs（make rootfs-test / make test 生成）
/initramfs.test.cpio.gz

# rootfs：仅跟踪手工维护的配置（etc/），bin/lib/init 链接等构建产物忽略
/rootfs/*
!/rootfs/etc/

# Linux 内核源码与编译产物（体积大，由 make kernel 从源码包构建）
/kernel
/linux-*.tar.xz

# 第三方 agent/任务缓存（非构建产物）
/.reasonix/
