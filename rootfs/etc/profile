# /etc/profile - system-wide shell initialization
# Sourced by rbox sh on startup (if run as login shell or via source)

# Set PATH
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Set hostname
export HOSTNAME=$(cat /etc/hostname 2>/dev/null || echo rbox)
export USER=root
export HOME=/

# Set prompt (minimal)
# 简约提示符
export PS1='> '

# Set default editor
export EDITOR=vi
